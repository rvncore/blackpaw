pkgname=blackpaw-test
pkgver=1.0
pkgrel=1
pkgdesc="BlackPaw repository test package"
arch=('any')
url="https://github.com/rvncore/blackpaw"
license=('GPL-3.0-only')

package() {
    install -dm755 "$pkgdir/usr/bin"

    cat > "$pkgdir/usr/bin/blackpaw-test" <<'EOF'
#!/bin/sh
echo "BlackPaw repository is working!"
EOF

    chmod 755 "$pkgdir/usr/bin/blackpaw-test"
}
